{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@nxt1/core": ["../core/src/index.ts", "../core/dist/index.d.ts"],
      "@nxt1/core/*": ["../core/src/*/index.ts", "../core/dist/*/index.d.ts"],
      "@nxt1/design-tokens": ["../design-tokens/src/index.ts"],
      "@nxt1/design-tokens/*": ["../design-tokens/src/*"],
      "@stripe/stripe-js": [
        "../../node_modules/@stripe/stripe-js/lib/index.d.ts"
      ],
      "@angular/*": ["../../node_modules/@angular/*"],
      "rxjs": ["../../node_modules/rxjs"],
      "rxjs/*": ["../../node_modules/rxjs/*"],
      "@ionic/*": ["../../node_modules/@ionic/*"],
      "@capacitor-firebase/storage": [
        "../../node_modules/@capacitor-firebase/storage/dist/esm/index.d.ts"
      ]
    }
  }
}
