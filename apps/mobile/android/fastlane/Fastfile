# NXT1 Android Fastlane Configuration
# ============================================================================
# Handles building and deployment for Android
# ============================================================================

default_platform(:android)

# App configuration
PACKAGE_NAME = "com.nxt1sports.app.twa"
GOOGLE_PLAY_KEY_FILE = File.expand_path("../google-play-key.json", __dir__)

platform :android do
  before_all do
    # Ensure gradle is ready
  end

  # ============================================================================
  # DEVELOPMENT BUILD (Debug APK)
  # ============================================================================
  desc "Build debug APK"
  lane :dev do
    gradle(
      task: "clean assembleDebug",
      project_dir: "./"
    )
    
    # Copy APK to build directory
    sh("mkdir -p ../build && cp ../app/build/outputs/apk/debug/*.apk ../build/NXT1-dev.apk")
  end

  # ============================================================================
  # BETA BUILD (Release APK for testing)
  # ============================================================================
  desc "Build beta APK for testing"
  lane :beta do
    # Increment version code
    increment_version_code(
      gradle_file_path: "app/build.gradle",
      version_code: ENV["GITHUB_RUN_NUMBER"]&.to_i || Time.now.strftime("%Y%m%d%H").to_i
    )

    gradle(
      task: "clean assembleRelease",
      project_dir: "./"
    )
    
    # Copy APK to build directory  
    sh("mkdir -p ../build && cp ../app/build/outputs/apk/release/*.apk ../build/NXT1-beta.apk")

    # Upload to Firebase App Distribution
    if ENV["FIREBASE_APP_ID_ANDROID"]
      firebase_app_distribution(
        app: ENV["FIREBASE_APP_ID_ANDROID"],
        groups: "internal-testers",
        android_artifact_type: "APK",
        android_artifact_path: "./app/build/outputs/apk/release/app-release.apk",
        release_notes: changelog_from_git_commits(
          commits_count: 10,
          pretty: "- %s"
        )
      )
    end
  end

  # ============================================================================
  # STAGING BUILD (AAB — version code from GitHub run number, no Play Store API)
  # ============================================================================
  desc "Build staging AAB for Play Store Internal Track"
  lane :release_staging do
    gradle_file = "app/build.gradle"
    checked_in_version_code = current_gradle_version_code(gradle_file_path: gradle_file)
    version_code = android_ci_version_code_floor(checked_in_version_code: checked_in_version_code)

    UI.message("Android staging versionCode selected: #{version_code} (checked-in #{checked_in_version_code})")

    increment_version_code(
      gradle_file_path: gradle_file,
      version_code: version_code
    )

    gradle(
      task: "clean bundleRelease",
      project_dir: "./"
    )

    sh("mkdir -p ../build && cp ../app/build/outputs/bundle/release/*.aab ../build/NXT1-release.aab")
  end

  # ============================================================================
  # PRODUCTION BUILD (AAB — version code from Play Store)
  # ============================================================================
  desc "Build production AAB for Play Store"
  lane :release do
    gradle_file = "app/build.gradle"
    checked_in_version_code = current_gradle_version_code(gradle_file_path: gradle_file)
    ci_version_floor = android_ci_version_code_floor(checked_in_version_code: checked_in_version_code)
    play_version_floor = 0

    # Try to get the latest version code from Play Store; always keep CI builds
    # above the checked-in Android version code so Play can upgrade existing users.
    key_file = GOOGLE_PLAY_KEY_FILE
    if File.exist?(key_file) && File.size(key_file) > 10
      begin
        tracks = %w[internal alpha beta production]
        version_codes = tracks.flat_map do |track|
          google_play_track_version_codes(
            track: track,
            json_key: key_file,
            package_name: PACKAGE_NAME
          )
        rescue => e
          UI.important("⚠️  Could not fetch Play Store version codes for #{track}: #{e.message}")
          []
        end
        play_version_floor = (version_codes.max || 0) + 1
      rescue => e
        UI.important("⚠️  Could not fetch Play Store version codes: #{e.message}")
        UI.important("⚠️  Falling back to CI/check-in floor for version code.")
      end
    else
      UI.important("⚠️  google-play-key.json not found or empty — using CI/check-in floor for version code.")
    end

    new_version_code = [play_version_floor, ci_version_floor, checked_in_version_code + 1].max
    UI.message(
      "Android production versionCode selected: #{new_version_code} " \
      "(checked-in #{checked_in_version_code}, CI floor #{ci_version_floor}, Play floor #{play_version_floor})"
    )

    increment_version_code(
      gradle_file_path: gradle_file,
      version_code: new_version_code
    )

    gradle(
      task: "clean bundleRelease",
      project_dir: "./"
    )

    # Copy AAB to build directory
    sh("mkdir -p ../build && cp ../app/build/outputs/bundle/release/*.aab ../build/NXT1-release.aab")
  end

  # ============================================================================
  # PLAY STORE UPLOAD - INTERNAL TRACK
  # ============================================================================
  desc "Upload to Play Store Internal Track"
  lane :upload_internal do
    upload_to_play_store(
      track: "internal",
      aab: "./app/build/outputs/bundle/release/app-release.aab",
      json_key: GOOGLE_PLAY_KEY_FILE,
      package_name: PACKAGE_NAME,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )
  end

  # ============================================================================
  # PLAY STORE UPLOAD - PRODUCTION
  # ============================================================================
  desc "Upload to Play Store Production"
  lane :upload_production do
    upload_to_play_store(
      track: "production",
      aab: "./app/build/outputs/bundle/release/app-release.aab",
      json_key: GOOGLE_PLAY_KEY_FILE,
      package_name: PACKAGE_NAME,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: "completed",
      rollout: "1" # 10% rollout initially
    )
  end

  # ============================================================================
  # PROMOTE FROM INTERNAL TO PRODUCTION
  # ============================================================================
  desc "Promote from internal to production"
  lane :promote_to_production do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      json_key: GOOGLE_PLAY_KEY_FILE,
      package_name: PACKAGE_NAME,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      rollout: "1"
    )
  end

  # ============================================================================
  # HELPERS
  # ============================================================================
  private_lane :increment_version_code do |options|
    path = options[:gradle_file_path]
    version_code = options[:version_code]
    
    sh("sed -i 's/versionCode [0-9]*/versionCode #{version_code}/' ../#{path}")
  end

  private_lane :current_gradle_version_code do |options|
    path = options[:gradle_file_path]
    gradle_file = File.expand_path("../#{path}", __dir__)
    match = File.read(gradle_file).match(/versionCode\s+(\d+)/)
    match ? match[1].to_i : 0
  end

  private_lane :android_ci_version_code_floor do |options|
    checked_in_version_code = options[:checked_in_version_code].to_i
    ci_run_number = ENV["GITHUB_RUN_NUMBER"].to_s
    ci_run_attempt = ENV["GITHUB_RUN_ATTEMPT"].to_s
    run_number = ci_run_number.match?(/\A\d+\z/) ? ci_run_number.to_i : 0
    run_attempt = ci_run_attempt.match?(/\A\d+\z/) ? ci_run_attempt.to_i : 0

    checked_in_version_code + run_number + [run_attempt, 1].max
  end

  # ============================================================================
  # ERROR HANDLING
  # ============================================================================
  error do |lane, exception|
    if ENV["SLACK_WEBHOOK_URL"]
      slack(
        message: "Android build failed: #{exception.message}",
        success: false,
        payload: {
          "Lane" => lane,
          "Build Number" => ENV["GITHUB_RUN_NUMBER"]
        }
      )
    end
  end
end
