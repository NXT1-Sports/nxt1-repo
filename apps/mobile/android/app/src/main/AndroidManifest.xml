<?xml version="1.0" encoding="utf-8" ?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Route-level screen tracking is sent manually from Angular.
             Disable Firebase native auto screen reporting to prevent
             framework container classes from polluting page analytics. -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links - Opens app from nxt1sports.com links -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="nxt1sports.com" />
                <data android:scheme="https" android:host="www.nxt1sports.com" />
                <data android:scheme="https" android:host="app.nxt1sports.com" />
            </intent-filter>

            <!-- Custom URL Scheme (nxt1://) for legacy deep links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nxt1" />
            </intent-filter>

            <!-- Custom URL Scheme (nxt1sports://) for OAuth callbacks (Google, Microsoft) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nxt1sports" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true"
            android:noHistory="true"
            android:launchMode="singleTask">
            <!-- Fix Issue #2: noHistory=true prevents MSAL's fragment from accumulating
                 in the back stack when MainActivity uses singleTask launch mode.
                 Without this, system-restore of the auth activity finds a stale fragment
                 type and throws IllegalStateException: Unexpected fragment type.
                 Fix Issue #3: launchMode="singleTask" prevents OxygenOS (OnePlus) from
                 re-creating BrowserTabActivity in a new task after the msauth:// redirect,
                 which would present a stale/mismatched FragmentManager state to
                 CurrentTaskAuthorizationActivity and trigger the same crash. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="msauth"
                    android:host="${applicationId}"
                    android:path="${msauthRedirectPath}" />
            </intent-filter>
        </activity>

        <!-- MSAL current-task auth can be recreated by OEM task restore after process
             death (notably OxygenOS/Android 11). The restored activity may run before
             MSAL's process-level LibraryConfiguration is rebuilt, causing
             CurrentTaskAuthorizationActivity.onCreate() to construct the wrong
             fragment type and crash with "Unexpected fragment type". Keep the
             internal auth activity out of task restoration instead of preserving a
             half-finished OAuth fragment state. -->
        <activity
            android:name="com.microsoft.identity.common.internal.providers.oauth2.CurrentTaskAuthorizationActivity"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:stateNotNeeded="true" />

        <!-- BrokerActivity stores the nested Authenticator/broker launch Intent in
             process memory/saved state and calls startActivityForResult() from
             onResume(). If Android restores this internal activity after the broker
             Intent was lost, MSAL/common can pass null into the framework and crash
             while ActivityTaskManager migrates stream extras. Do not restore a stale
             broker handoff; let the sign-in attempt fail/cancel and restart cleanly. -->
        <activity
            android:name="com.microsoft.identity.common.internal.broker.BrokerActivity"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:stateNotNeeded="true" />

        <!-- Remove the transitive YubiKit prompt entirely. MSAL pulls this in for
             optional smart-card flows, but our app does not invoke it directly.
             Android can still recreate a non-exported activity from task state,
             and YubiKeyPromptActivity crashes in onCreate when launched without
             library-provided extras (Objects.requireNonNull(getIntent().getExtras())).
             Removing it avoids restore-time crashes from an otherwise unused
             transitive activity. -->
        <activity
            android:name="com.yubico.yubikit.android.ui.YubiKeyPromptActivity"
            tools:node="remove" />

        <!-- Remove MSAL InstallCertActivityLauncher — NXT1 does not use enterprise
             device certificate enrollment (conditional access cert flows).
             MSAL 8.3.x has a bug where InstallCertActivityLauncher.onResume calls
             activityResultLauncher.launch(intent) with a null Intent when the
             Microsoft Authenticator broker is absent, crashing with NPE.
             Removing the activity entirely prevents this path from running. -->
        <activity
            android:name="com.microsoft.identity.common.internal.broker.InstallCertActivityLauncher"
            tools:node="remove" />



        <!-- IAP is iOS-only. Remove ProxyBillingActivity from the merged manifest
             to prevent a crash (NPE on null PendingIntent) that occurs when
             Android attempts to restore or launch this activity on Android devices.
             The @capgo/native-purchases plugin registers this activity via the
             Play Billing library, but it must never run on this Android build. -->
        <activity
            android:name="com.android.billingclient.api.ProxyBillingActivity"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Fingerprint/Biometric: USE_FINGERPRINT implies android.hardware.fingerprint — must be optional -->
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!-- Geolocation Permissions (Required for @capacitor/geolocation) -->
    <!-- ACCESS_COARSE_LOCATION implies location.network; ACCESS_FINE_LOCATION implies location.gps — both optional -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Camera Permissions (for profile photos and videos) -->
    <!-- required="false" ensures devices without cameras (tablets, etc.) are not filtered from Play Store -->
    <!-- android.permission.CAMERA implicitly requires camera + camera.autofocus — both must be optional -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature
    android:name="android.hardware.telephony"
    android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Use Android Photo Picker/Capacitor Camera picker instead of broad media-library access. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <!-- Fix Issue #4: Android 11 (API 30) requires explicit package visibility declarations.
         Without this, MSAL cannot query or bind to the Custom Tabs service (Chrome/browser),
         causing the OAuth browser-based auth flow to fail silently or crash in
         CurrentTaskAuthorizationActivity during the redirect phase. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
