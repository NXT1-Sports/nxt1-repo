# NXT1 iOS Fastlane Configuration
# ============================================================================
# Handles code signing, building, and deployment for iOS
# ============================================================================

default_platform(:ios)

# App configuration
APP_IDENTIFIER = "com.nxt1sports.nxt1"
APPLE_ID = ENV["APPLE_ID"] || "developer@nxt1.app"
TEAM_ID = ENV["APPLE_TEAM_ID"]

platform :ios do
  before_all do
    setup_ci if ENV['CI']
  end

  # ============================================================================
  # CODE SIGNING (using match)
  # ============================================================================
  desc "Sync certificates and profiles"
  lane :sync_certs do |options|
    type = options[:type] || "development"
    api_key = load_api_key
    # In CI, run read-only: fetch certs from the git repo without hitting
    # Apple's certificate creation API (avoids team membership errors).
    is_readonly = ENV['CI'] == 'true'

    match(
      type: type,
      app_identifier: APP_IDENTIFIER,
      readonly: is_readonly,
      team_id: ENV['APPLE_TEAM_ID'] || '794G2RS4WQ',
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      api_key: api_key,
    )
  end

  # ============================================================================
  # DEVELOPMENT BUILD
  # ============================================================================
  desc "Build development IPA"
  lane :dev do
    sync_certs(type: "development")
    
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Debug",
      export_method: "development",
      output_directory: "./build",
      output_name: "NXT1-dev.ipa",
      clean: true,
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=794G2RS4WQ CODE_SIGN_IDENTITY='Apple Development' PROVISIONING_PROFILE_SPECIFIER='match Development com.nxt1sports.nxt1'"
    )
  end

  # ============================================================================
  # BETA BUILD (Ad-hoc for Firebase Distribution)
  # ============================================================================
  desc "Build beta IPA for testing"
  lane :beta do
    sync_certs(type: "adhoc")
    
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "ad-hoc",
      output_directory: "./build",
      output_name: "NXT1-beta.ipa",
      clean: true,
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=794G2RS4WQ CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AdHoc com.nxt1sports.nxt1'"
    )

    # Upload to Firebase App Distribution
    if ENV["FIREBASE_APP_ID_IOS"]
      firebase_app_distribution(
        app: ENV["FIREBASE_APP_ID_IOS"],
        groups: "internal-testers",
        release_notes: changelog_from_git_commits(
          commits_count: 10,
          pretty: "- %s"
        )
      )
    end
  end

  # ============================================================================
  # RELEASE BUILD (App Store)
  # ============================================================================
  desc "Build release IPA for App Store"
  lane :release do
    sync_certs(type: "appstore")

    # auto_version decides the next marketing version and build number:
    #   - If current xcodeproj version is already LIVE on the App Store
    #     → bump patch (e.g. 5.0.5 → 5.0.6) and reset build to 1
    #   - Otherwise → keep current version and increment build counter
    result            = auto_version
    marketing_version = result[:version]
    build_number      = result[:build]

    increment_build_number(
      build_number: build_number.to_s,
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "NXT1-release.ipa",
      clean: true,
      include_bitcode: false,
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=794G2RS4WQ CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore com.nxt1sports.nxt1'"
    )
  end

  # ============================================================================
  # TESTFLIGHT UPLOAD
  # ============================================================================
  desc "Upload to TestFlight and distribute to internal testers"
  lane :upload_testflight do
    api_key = load_api_key

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/NXT1-release.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: changelog_from_git_commits(
        commits_count: 10,
        pretty: "- %s"
      )
    )
  end

  # ============================================================================
  # APP STORE SUBMISSION
  # ============================================================================
  desc "Submit already-uploaded build to App Store for review (production only)"
  lane :submit_app_store do
    # Safety guard — this lane must only run on production builds.
    unless ENV['BUILD_PROFILE'] == 'production'
      UI.important("⚠️  submit_app_store skipped — BUILD_PROFILE is '#{ENV['BUILD_PROFILE']}', not 'production'")
      next
    end

    api_key = load_api_key

    notes = changelog_from_git_commits(
      commits_count: 10,
      pretty: "- %s",
      merge_commit_filtering: "exclude_merges"
    )

    # Deliver requires a metadata directory with release_notes.txt in order to
    # set the mandatory 'whatsNew' field on the App Store version.
    # We create a minimal temp dir so we only touch that one field.
    meta_dir = "/tmp/nxt1_metadata/en-US"
    require 'fileutils'
    FileUtils.mkdir_p(meta_dir)
    File.write("#{meta_dir}/release_notes.txt", notes)

    # The binary was already uploaded by upload_testflight — skip_binary_upload
    # prevents a duplicate-upload error from Apple (-19232).
    upload_to_app_store(
      api_key: api_key,
      metadata_path: "/tmp/nxt1_metadata",
      submit_for_review: true,
      automatic_release: false,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  # ============================================================================
  # HELPERS
  # ============================================================================

  # Automatically determines the next (version, build) pair:
  #
  #   1. Reads the current marketing version from App.xcodeproj.
  #   2. Queries App Store Connect for the version currently LIVE on the App Store.
  #   3a. If live version == xcodeproj version → the previous cycle is done.
  #       Bumps the patch component (5.0.5 → 5.0.6), resets build to 1.
  #   3b. Otherwise → still building for this version. Increments the highest
  #       build number already uploaded to TestFlight for that version.
  #
  # The result is applied by the caller (release lane) via increment_build_number.
  # increment_version_number is called here when a bump is needed.
  private_lane :auto_version do
    api_key         = load_api_key
    current_version = get_version_number(xcodeproj: "App.xcodeproj", target: "App")

    # Connect to App Store Connect and fetch the live version string
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:    api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      key:       api_key[:key]
    )
    app                 = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    live_version_string = app.get_live_app_store_version&.version_string
    UI.message("▶ App Store live version: #{live_version_string || '(none)'}  |  xcodeproj version: #{current_version}")

    target_version = current_version

    if live_version_string
      live_ver    = Gem::Version.new(live_version_string)
      current_ver = Gem::Version.new(current_version)

      if live_ver >= current_ver
        # Live version is ahead of (or equal to) xcodeproj — xcodeproj was never
        # updated after the last release. Bump one patch above whatever is live.
        parts          = live_version_string.split('.').map(&:to_i)
        parts[-1]     += 1
        target_version = parts.join('.')
        increment_version_number(version_number: target_version, xcodeproj: "App.xcodeproj")
        UI.message("▶ App Store live (#{live_version_string}) >= xcodeproj (#{current_version}) → auto-bumped to #{target_version}")
      end
    end

    # Determine the next build number for target_version
    # (returns 0 when no build exists for that version yet)
    latest_build = begin
      latest_testflight_build_number(
        app_identifier: APP_IDENTIFIER,
        api_key:        api_key,
        version:        target_version
      )
    rescue
      0
    end
    next_build = latest_build.to_i + 1

    UI.message("▶ Next build: #{target_version} (#{next_build})  [TestFlight latest for #{target_version}: #{latest_build}]")
    { version: target_version, build: next_build }
  end

  private_lane :load_api_key do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house: false
    )
  end

  # ============================================================================
  # ERROR HANDLING
  # ============================================================================
  error do |lane, exception|
    if ENV["SLACK_WEBHOOK_URL"]
      slack(
        message: "iOS build failed: #{exception.message}",
        success: false,
        payload: {
          "Lane" => lane,
          "Build Number" => ENV["GITHUB_RUN_NUMBER"]
        }
      )
    end
  end
end
