{
  "name": "@nxt1/backend",
  "version": "1.69.2",
  "description": "NXT1 Backend API Server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23",
    "npm": ">=11"
  },
  "main": "dist/index.js",
  "scripts": {
    "start": "node -r dotenv/config dist/index.js",
    "start:staging": "NODE_ENV=staging node -r dotenv/config dist/index.js",
    "start:prod": "NODE_ENV=production node -r dotenv/config dist/index.js",
    "dev": "nodemon --watch src --ext ts,js,json --exec \"npm run build && npm start\"",
    "dev:staging": "NODE_ENV=staging nodemon --watch src --ext ts,js,json --exec \"npm run build && npm run start:staging\"",
    "dev:prod": "NODE_ENV=production nodemon --watch src --ext ts,js,json --exec \"npm run build && npm run start:prod\"",
    "build": "corepack npm run build --workspace=@nxt1/core && corepack npm run build --workspace=@nxt1/cache && rimraf tsconfig.tsbuildinfo && tsc && shx cp -r src/routes/billing/iap-certs dist/routes/billing/iap-certs",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo node_modules",
    "deploy:staging": "gcloud app deploy --project nxt1-staging",
    "deploy:prod": "gcloud app deploy --project nxt1-production",
    "migrate:mongo:environment": "npx tsx scripts/migrate-mongo-environment.ts",
    "migrate:legacy-subs-to-usage": "tsx scripts/migration/migrate-legacy-subs-to-usage.ts --target=production",
    "migrate:legacy-subs-to-usage:dry-run": "tsx scripts/migration/migrate-legacy-subs-to-usage.ts --target=production --dry-run --verbose",
    "migrate:search-indexes": "tsx scripts/data-migrations/migrate-search-indexes.ts",
    "migrate:search-indexes:dry-run": "tsx scripts/data-migrations/migrate-search-indexes.ts --dry-run",
    "worker:stripe": "tsx src/workers/stripe-worker.ts",
    "reconcile:usage": "tsx scripts/reconcile-usage-events.ts",
    "reconcile:usage:dry-run": "tsx scripts/reconcile-usage-events.ts --dry-run",
    "reconcile:usage:staging": "tsx scripts/reconcile-usage-events.ts --staging",
    "migrate:billing-contexts": "tsx scripts/migrate-billing-contexts.ts",
    "migrate:billing-contexts:dry-run": "tsx scripts/migrate-billing-contexts.ts --dry-run",
    "migrate:weekly-recap-jobs": "tsx scripts/data-migrations/migrate-weekly-recap-jobs.ts --commit",
    "migrate:weekly-recap-jobs:dry-run": "tsx scripts/data-migrations/migrate-weekly-recap-jobs.ts",
    "cleanup:analytics:lifecycle-noise": "tsx scripts/cleanup-analytics-lifecycle-noise.ts",
    "cleanup:analytics:lifecycle-noise:dry-run": "tsx scripts/cleanup-analytics-lifecycle-noise.ts --dry-run",
    "backfill:activity-badges": "tsx scripts/backfill-activity-badges.ts",
    "backfill:activity-badges:commit": "tsx scripts/backfill-activity-badges.ts --commit",
    "backfill:activity-badges:staging": "tsx scripts/backfill-activity-badges.ts --staging",
    "backfill:universal-team-docs:staging": "tsx --tsconfig tsconfig.scripts.json scripts/data-migrations/backfill-universal-team-documents.ts --staging",
    "backfill:universal-team-docs:staging:commit": "tsx --tsconfig tsconfig.scripts.json scripts/data-migrations/backfill-universal-team-documents.ts --staging --commit",
    "ensure:universal-file-semantic-index": "tsx --tsconfig tsconfig.scripts.json scripts/data-migrations/ensure-universal-file-semantic-index.ts",
    "ensure:universal-file-semantic-index:dry-run": "tsx --tsconfig tsconfig.scripts.json scripts/data-migrations/ensure-universal-file-semantic-index.ts --dry-run",
    "backfill:universal-file-semantics": "tsx --tsconfig tsconfig.scripts.json scripts/data-migrations/backfill-universal-file-semantics.ts",
    "backfill:universal-file-semantics:commit": "tsx --tsconfig tsconfig.scripts.json scripts/data-migrations/backfill-universal-file-semantics.ts --commit",
    "backfill:universal-file-semantics:staging": "tsx --tsconfig tsconfig.scripts.json scripts/data-migrations/backfill-universal-file-semantics.ts --staging",
    "backfill:universal-file-semantics:staging:commit": "tsx --tsconfig tsconfig.scripts.json scripts/data-migrations/backfill-universal-file-semantics.ts --staging --commit",
    "cache:clear": "tsx scripts/clear-cache.ts",
    "cache:clear:staging": "tsx scripts/clear-cache.ts --env=staging",
    "cache:clear:profiles": "tsx scripts/clear-cache.ts --pattern=profile:*",
    "cache:clear:teams": "tsx scripts/clear-cache.ts --pattern=team:*",
    "model-routing:apply": "tsx --tsconfig tsconfig.scripts.json scripts/config/apply-agent-model-routing.ts",
    "model-routing:staging:use-prod-current": "npm run model-routing:apply -- --target=staging --preset=production-current",
    "model-routing:staging:use-staging-current": "npm run model-routing:apply -- --target=staging --preset=staging-current",
    "model-routing:prod:use-prod-current": "npm run model-routing:apply -- --target=production --preset=production-current",
    "model-routing:prod:use-staging-current": "npm run model-routing:apply -- --target=production --preset=staging-current",
    "seed:agent-config": "tsx --tsconfig tsconfig.scripts.json scripts/migrate-agent-config.ts",
    "seed:agent-config:prod-v2": "GOOGLE_CLOUD_PROJECT=nxt-1-v2 GCLOUD_PROJECT=nxt-1-v2 tsx --tsconfig tsconfig.scripts.json scripts/migrate-agent-config.ts",
    "seed:agent-config:staging-v2": "GOOGLE_CLOUD_PROJECT=nxt-1-staging-v2 GCLOUD_PROJECT=nxt-1-staging-v2 tsx --tsconfig tsconfig.scripts.json scripts/migrate-agent-config.ts --staging",
    "seed:knowledge": "tsx --tsconfig tsconfig.scripts.json ../scripts/ai/seed-knowledge/index.ts",
    "deploy:mcp:stateful": "bash ./scripts/deploy-stateful-mcp.sh",
    "deploy:mcp:chart": "bash ./scripts/deploy-chart-mcp.sh",
    "deploy:mcp:drawio": "bash ./scripts/deploy-drawio-mcp.sh",
    "deploy:mcp:google-workspace": "bash ./scripts/deploy-google-workspace-mcp.sh",
    "deploy:mcp:microsoft-365": "bash ./scripts/deploy-microsoft-365-mcp.sh",
    "backfill:agent-message-interactions": "tsx scripts/backfill-agent-message-interactions.ts",
    "backfill:agent-message-interactions:commit": "tsx scripts/backfill-agent-message-interactions.ts --commit",
    "backfill:agent-message-interactions:prod": "NODE_ENV=production tsx scripts/backfill-agent-message-interactions.ts --commit",
    "deploy:mobile-bundle": "tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts",
    "deploy:mobile-bundle:staging": "NODE_ENV=staging tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts --channel staging",
    "deploy:mobile-bundle:prod": "NODE_ENV=production tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts --channel production",
    "deploy:mobile-bundle:ios:staging": "NODE_ENV=staging tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts --channel staging --platform ios",
    "deploy:mobile-bundle:ios:prod": "NODE_ENV=production tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts --channel production --platform ios",
    "deploy:mobile-bundle:android:staging": "NODE_ENV=staging tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts --channel staging --platform android",
    "deploy:mobile-bundle:android:prod": "NODE_ENV=production tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts --channel production --platform android",
    "deploy:ota:ios": "NODE_ENV=production tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts --channel production --platform ios",
    "deploy:ota:ios:staging": "NODE_ENV=staging tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts --channel staging --platform ios",
    "deploy:ota:android": "NODE_ENV=production tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts --channel production --platform android",
    "deploy:ota:android:staging": "NODE_ENV=staging tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/deploy-mobile-bundle.ts --channel staging --platform android",
    "storage:cors": "bash ./scripts/utilities/configure-storage-cors.sh",
    "test:live:e2e-user": "tsx --tsconfig tsconfig.scripts.json scripts/utilities/request-as-e2e-user.ts",
    "smoke:universal-team-docs": "tsx --tsconfig tsconfig.scripts.json scripts/utilities/smoke-universal-team-documents.ts",
    "smoke:universal-team-docs:local": "npm run smoke:universal-team-docs -- --target local",
    "smoke:universal-team-docs:staging": "npm run smoke:universal-team-docs -- --target staging",
    "email:setup-brevo-migration": "node scripts/email/setup-brevo-migration-campaign.mjs",
    "email:b2b-notion-leads:dry-run": "tsx --tsconfig tsconfig.scripts.json scripts/email/send-b2b-notion-leads.ts",
    "email:b2b-notion-leads:send": "tsx --tsconfig tsconfig.scripts.json scripts/email/send-b2b-notion-leads.ts --commit",
    "email:b2b-notion-leads:initial:dry-run": "tsx --tsconfig tsconfig.scripts.json scripts/email/send-b2b-notion-leads.ts --sequence-step=initial",
    "email:b2b-notion-leads:initial:send": "tsx --tsconfig tsconfig.scripts.json scripts/email/send-b2b-notion-leads.ts --sequence-step=initial --commit",
    "email:b2b-notion-leads:follow-up:dry-run": "tsx --tsconfig tsconfig.scripts.json scripts/email/send-b2b-notion-leads.ts --sequence-step=follow_up",
    "email:b2b-notion-leads:follow-up:send": "tsx --tsconfig tsconfig.scripts.json scripts/email/send-b2b-notion-leads.ts --sequence-step=follow_up --commit",
    "email:b2b-partner:dry-run": "tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/email/send-b2b-partner-brand-awareness.ts",
    "email:b2b-partner:send": "tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/email/send-b2b-partner-brand-awareness.ts --commit",
    "email:monthly-campaign-01:test": "tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/email/send-monthly-campaign-01-test.ts",
    "email:monthly-campaign-01:test:send": "tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/email/send-monthly-campaign-01-test.ts --commit",
    "email:monthly-campaign-01:gmail:dry-run": "tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/email/send-monthly-campaign-01-gmail.ts",
    "email:monthly-campaign-01:gmail:send": "tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/email/send-monthly-campaign-01-gmail.ts --commit",
    "email:monthly-campaign-01:gmail:resume": "tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/email/send-monthly-campaign-01-gmail.ts --commit --resume",
    "email:support:test": "tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/email/send-support-test-email.ts",
    "email:support:test:send": "tsx --tsconfig tsconfig.scripts.json --import dotenv/config scripts/email/send-support-test-email.ts --commit",
    "email:legacy:gmail:dry-run": "node scripts/email/send-legacy-users-gmail.mjs",
    "email:legacy:gmail:send": "node scripts/email/send-legacy-users-gmail.mjs --commit",
    "email:legacy:gmail:resume": "node scripts/email/send-legacy-users-gmail.mjs --commit --resume"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@apple/app-store-server-library": "^3.0.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@google-cloud/firestore": "^8.0.0",
    "@google-cloud/pubsub": "^5.2.3",
    "@google/generative-ai": "^0.24.1",
    "@imbsq/runway-mcp": "^1.0.0",
    "@mendable/firecrawl-js": "^4.28.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nxt1/cache": "file:../packages/cache",
    "@nxt1/core": "file:../packages/core",
    "apify-client": "^2.22.3",
    "axios": "^1.18.1",
    "bullmq": "^5.76.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.8.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "mongoose": "^9.1.1",
    "multer": "^2.2.0",
    "node-html-markdown": "^2.0.0",
    "nodemailer": "^9.0.1",
    "pdfjs-dist": "^5.4.296",
    "pdf-parse": "^2.4.5",
    "pdfmake": "^0.3.11",
    "rate-limit-redis": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.2",
    "stripe": "^22.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nxt1/config": "file:../packages/config",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfmake": "^0.3.2",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.0",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "shx": "^0.4.0",
    "supertest": "^7.2.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "chokidar": "^4.0.3",
    "esbuild": "0.28.1",
    "hono": "4.12.26",
    "postcss": "^8.5.12",
    "protobufjs": "8.6.4",
    "@google-cloud/storage": {
      "uuid": "11.1.1"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    },
    "vite": "^7.3.2"
  }
}
